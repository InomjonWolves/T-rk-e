rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin: Firebase konsolida qoʻlda yaratilgan admins/{uid} hujjati bor hisob
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Admins roʻyxatini faqat oʻsha hisobning oʻzi tekshira oladi; yozish faqat konsoldan
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
    // Anonim statistika: ism va pochtasiz koʻnikma koʻrsatkichlari.
    // Har kim faqat oʻz hujjatini yozadi va oʻchiradi, oʻqish faqat admin uchun.
    match /stats/{uid} {
      allow read: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'd', 'lv', 'units', 't', 'w', 'bal', 'lvl', 'kt', 'act'])
        && request.resource.data.v is int
        && request.resource.data.d is string && request.resource.data.d.size() == 10
        && request.resource.data.lv is string && request.resource.data.lv.size() <= 2
        && request.resource.data.units is int && request.resource.data.units <= 64
        && request.resource.data.bal is int && request.resource.data.bal >= 0 && request.resource.data.bal <= 100
        && request.resource.data.act is int && request.resource.data.act <= 14
        && request.resource.data.t is map && request.resource.data.w is map
        && request.resource.data.lvl is map && request.resource.data.kt is map;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Har bir foydalanuvchi faqat oʻz hujjatini oʻqiy va yoza oladi
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Reyting: hisobga kirganlar oʻqiydi, har kim faqat oʻz qatorini yozadi
    match /league/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'week', 'wxp', 'xp', 'streak'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.wxp is int && request.resource.data.xp is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Profil rasmlari: kichik JPEG (100 KB gacha), faqat egasi yozadi
    match /avatars/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['photo'])
        && request.resource.data.photo is string
        && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.photo.size() < 140000;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
