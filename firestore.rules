rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Har bir foydalanuvchi faqat oʻz hujjatini oʻqiy va yoza oladi
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Reyting: hisobga kirganlar oʻqiydi, har kim faqat oʻz qatorini yozadi
    match /league/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'week', 'wxp', 'xp', 'streak'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.wxp is int && request.resource.data.xp is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
