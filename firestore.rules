rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tasdiqlangan hisob: pochtasi tasdiqlangan (email/parol yoki Google)
    function okUser() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true;
    }
    // Admin: Firebase konsolida qoʻlda yaratilgan admins/{uid} hujjati bor hisob
    function isAdmin() {
      return okUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Admins roʻyxatini faqat oʻsha hisobning oʻzi tekshira oladi; yozish faqat konsoldan
    match /admins/{uid} {
      allow get: if okUser() && request.auth.uid == uid;
    }
    // Anonim statistika: ism va pochtasiz koʻnikma koʻrsatkichlari.
    // Har kim faqat oʻz hujjatini yozadi va oʻchiradi, oʻqish faqat admin uchun.
    match /stats/{uid} {
      allow read: if isAdmin();
      allow create, update: if okUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['v', 'd', 'lv', 'units', 't', 'w', 'bal', 'lvl', 'kt', 'act'])
        && request.resource.data.v is int
        && request.resource.data.d is string && request.resource.data.d.size() == 10
        && request.resource.data.lv is string && request.resource.data.lv.size() <= 2
        && request.resource.data.units is int && request.resource.data.units <= 64
        && request.resource.data.bal is int && request.resource.data.bal >= 0 && request.resource.data.bal <= 100
        && request.resource.data.act is int && request.resource.data.act <= 14
        && request.resource.data.t is map && request.resource.data.w is map
        && request.resource.data.lvl is map && request.resource.data.kt is map;
      allow delete: if okUser() && request.auth.uid == uid;
    }
    // Har bir foydalanuvchi faqat oʻz hujjatini oʻqiy va yoza oladi (tasdiqlangan hisob)
    match /users/{uid} {
      allow read, write: if okUser() && request.auth.uid == uid;
    }
    // Reyting: hisobga kirganlar oʻqiydi, har kim faqat oʻz qatorini yozadi.
    // Kunlik (day, dxp), haftalik liga ichida (week, wxp, lg) va umumiy (xp). Oʻtgan hafta (pw, pwxp, plg) — ligalarni hisoblash uchun.
    // Halollik: kunlik va haftalik XP chegarasi, XP oʻsish tezligi (at — server vaqti), liga haftasiga bir marta ±1.
    match /league/{uid} {
      function lgOk(d) {
        return d.keys().hasOnly(['name', 'week', 'wxp', 'xp', 'streak', 'day', 'dxp', 'lg', 'lgw', 'pw', 'pwxp', 'plg', 'at'])
          && d.name is string && d.name.size() <= 24
          && d.wxp is int && d.xp is int && d.wxp >= 0 && d.wxp <= d.xp && d.wxp <= 25000
          && d.get('dxp', 0) is int && d.get('dxp', 0) >= 0 && d.get('dxp', 0) <= 3500
          && d.get('pwxp', 0) is int && d.get('pwxp', 0) >= 0 && d.get('pwxp', 0) <= 25000
          && d.get('lg', 1) is int && d.get('lg', 1) >= 1 && d.get('lg', 1) <= 7
          && d.get('plg', 1) is int && d.get('plg', 1) >= 1 && d.get('plg', 1) <= 7
          && d.xp >= (d.get('lg', 1) - 1) * 300
          && d.get('week', '') is string && d.get('week', '').size() <= 10
          && d.get('day', '') is string && d.get('day', '').size() <= 10
          && d.get('lgw', '') is string && d.get('lgw', '').size() <= 10
          && d.get('pw', '') is string && d.get('pw', '').size() <= 10
          && (!('at' in d) || d.at == request.time);
      }
      allow read: if okUser();
      allow create: if okUser() && request.auth.uid == uid && lgOk(request.resource.data);
      allow update: if okUser() && request.auth.uid == uid && lgOk(request.resource.data)
        // Liga faqat yangi hafta hisob-kitobida (lgw = shu hafta) bir pogʻonaga oʻzgaradi
        && (request.resource.data.get('lg', 1) == resource.data.get('lg', 1)
          || (request.resource.data.get('lgw', '') != resource.data.get('lgw', '')
            && request.resource.data.get('lgw', '') == request.resource.data.week
            && request.resource.data.get('lg', 1) - resource.data.get('lg', 1) <= 1
            && resource.data.get('lg', 1) - request.resource.data.get('lg', 1) <= 1))
        // XP birdaniga 3000 dan, keyin sutkasiga ~3500 dan tez oʻsmaydi
        && (!('at' in resource.data)
          || request.resource.data.xp - resource.data.xp <= 3000 + (request.time.toMillis() - resource.data.at.toMillis()) / 25000);
      allow delete: if okUser() && request.auth.uid == uid;
    }
    // Guruhlar: oʻqituvchi (owner) yaratadi. Hujjat ID — 6 belgili kod; kodni bilgan hisob guruh nomini koʻra oladi.
    match /groups/{gid} {
      function g() { return get(/databases/$(database)/documents/groups/$(gid)).data; }
      function okGroup(d) {
        return d.keys().hasOnly(['name', 'owner', 'oname', 'at'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && d.oname is string && d.oname.size() <= 40;
      }
      allow read: if okUser();
      allow create: if okUser() && gid.matches('^[A-Z0-9]{6}$')
        && request.resource.data.owner == request.auth.uid && okGroup(request.resource.data);
      allow update: if okUser() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner && okGroup(request.resource.data);
      allow delete: if okUser() && resource.data.owner == request.auth.uid;
      // Aʼzo kartochkasi: ism, XP va 4 koʻnikma natijasi. Yozadi — faqat oʻzi; oʻqiydi — oʻqituvchi va guruhdoshlar;
      // oʻchiradi — oʻzi (chiqish) yoki oʻqituvchi (chiqarish)
      // Topshiriqlar: yaratadi va oʻchiradi — oʻqituvchi; oʻqiydi — oʻqituvchi va aʼzolar
      match /tasks/{tid} {
        allow read: if okUser() && (g().owner == request.auth.uid
          || exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)));
        allow create, update: if okUser() && g().owner == request.auth.uid && tid.matches('^[a-z0-9]{2,20}$')
          && request.resource.data.keys().hasOnly(['title', 'kind', 'ref', 'due', 'at'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 80
          && request.resource.data.kind in ['k', 'gx', 'oq']
          && request.resource.data.ref is string && request.resource.data.ref.size() <= 40
          && request.resource.data.due is string && request.resource.data.due.size() <= 10
          && request.resource.data.at == request.time;
        allow delete: if okUser() && g().owner == request.auth.uid;
      }
      match /members/{uid} {
        allow read: if okUser() && (request.auth.uid == uid || g().owner == request.auth.uid
          || exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)));
        allow create, update: if okUser() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/groups/$(gid)) && g().owner != uid
          && request.resource.data.keys().hasOnly(['name', 'week', 'wxp', 'xp', 'streak', 'last', 'sk', 'units', 'lv', 'act', 'tk', 'at'])
          && request.resource.data.get('tk', {}) is map
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.week is string && request.resource.data.week.size() <= 12
          && request.resource.data.last is string && request.resource.data.last.size() <= 10
          && request.resource.data.lv is string && request.resource.data.lv.size() <= 2
          && request.resource.data.wxp is int && request.resource.data.xp is int && request.resource.data.streak is int
          && request.resource.data.units is int && request.resource.data.act is int
          && request.resource.data.sk is map && request.resource.data.at == request.time;
        allow delete: if okUser() && (request.auth.uid == uid || g().owner == request.auth.uid);
      }
    }
    // Kunlik eslatma: FCM token, eslatma soati (UTC), vaqt zonasi, oxirgi mashq kuni, seriya. Faqat egasi; yuboruvchi server (service account) qoidalarsiz oʻqiydi
    match /push/{uid} {
      allow read, delete: if okUser() && request.auth.uid == uid;
      allow create, update: if okUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t', 'h', 'z', 'd', 's', 'at'])
        && request.resource.data.t is string && request.resource.data.t.size() <= 500
        && request.resource.data.h is int && request.resource.data.h >= 0 && request.resource.data.h <= 23
        && request.resource.data.z is int && request.resource.data.z >= -840 && request.resource.data.z <= 840
        && request.resource.data.d is string && request.resource.data.d.size() <= 10
        && request.resource.data.s is int && request.resource.data.at == request.time;
    }
    // Doʻstlik taklifi: B taklif havolasini ochib A ni doʻst qilsa, invites/{A}/from/{B} ga oʻz ismini yozadi.
    // A uni oʻqib, B ni ham doʻst qiladi va yozuvni oʻchiradi. Har kim faqat oʻz nomidan yozadi.
    match /invites/{owner}/from/{uid} {
      allow read, delete: if okUser() && request.auth.uid == owner;
      allow create, update: if okUser() && request.auth.uid == uid && uid != owner
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.at == request.time;
      allow delete: if okUser() && request.auth.uid == uid;
    }
    // Profil rasmlari: kichik JPEG (100 KB gacha), faqat egasi yozadi
    match /avatars/{uid} {
      allow read: if okUser();
      allow create, update: if okUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['photo'])
        && request.resource.data.photo is string
        && request.resource.data.photo.matches('^data:image/jpeg;base64,.*')
        && request.resource.data.photo.size() < 140000;
      allow delete: if okUser() && request.auth.uid == uid;
    }
  }
}
