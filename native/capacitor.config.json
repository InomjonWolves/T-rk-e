{
  "appId": "uz.turkceyol.app",
  "appName": "Türkçe Yoʻl",
  "webDir": "www",
  "android": {
    "path": "android",
    "backgroundColor": "#f7f4ee",
    "allowMixedContent": false,
    "captureInput": true
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_pamuk",
      "iconColor": "#3B5BDB"
    }
  }
}
